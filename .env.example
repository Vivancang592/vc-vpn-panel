APP_NAME="VC VPN PANEL"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://vpn.domain.com
APP_TIMEZONE=Asia/Ho_Chi_Minh

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vpn_service
DB_USERNAME=vpn_user
DB_PASSWORD=your_password
DB_TIMEZONE=+07:00

GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REDIRECT_URI="https://vpn.domain.com/auth/google/callback"

# Secret xác thực Webhook thanh toán (SePay / MacroDroid) - bắt buộc, để trống sẽ chặn mọi webhook
MACRODROID_SECRET=

# Secret xác thực CronJob (?key=... hoặc header X-Cron-Key) - bắt buộc, để trống sẽ chặn cron
CRON_SECRET_KEY=